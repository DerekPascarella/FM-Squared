<Window x:Class="FMSquared.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15,8">
        <TextBlock FontWeight="Bold" FontSize="16">
            <Run Text="FM^2"/>
            <Run x:Name="VersionRun"/>
        </TextBlock>
        <TextBlock Margin="0,4,0,0">by Derek Pascarella (ateam)</TextBlock>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">An SD card management tool for the FM Towns/FM Towns Marty ODEs DocBrown and Wizard.</TextBlock>
        <TextBlock Margin="0,10,0,0">Documentation:</TextBlock>
        <TextBlock Margin="0,2,0,0">
            <Hyperlink Click="Hyperlink_Click"
                       ToolTip="Open the GitHub repository in your browser">https://github.com/DerekPascarella/FM-Squared</Hyperlink>
        </TextBlock>
        <Button Content="Check for Updates" Click="CheckForUpdatesButton_Click"
                Margin="0,15,0,0" HorizontalAlignment="Right"
                Padding="12,0" Height="28"
                VerticalContentAlignment="Center"
                ToolTip="Check GitHub for a newer version"/>
    </StackPanel>
</Window>
