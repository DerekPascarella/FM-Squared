<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FMSquared.DiscImageOptionsWindow"
        Title="Disc Image Options" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" CanMinimize="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <HeaderedContentControl>
            <HeaderedContentControl.Header>
                <TextBlock Text="Conversion Format" FontWeight="Bold"/>
            </HeaderedContentControl.Header>
            <StackPanel Margin="8">
                <TextBlock Text="Format used when automatically converting disc images to a DocBrown/Wizard-compatible format."
                           TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0 0 0 10"/>
                <RadioButton x:Name="CcdRadioButton" Content="CCD/IMG/SUB" GroupName="ConversionFormat"/>
                <RadioButton x:Name="CdiRadioButton" Content="CDI" GroupName="ConversionFormat" Margin="0 5 0 0"/>
            </StackPanel>
        </HeaderedContentControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 5 0 0">
            <Button Content="Save" Width="80" Padding="15,8" Click="SaveButton_Click" IsDefault="True"
                    ToolTip.Tip="Save conversion format preference"/>
        </StackPanel>
    </Grid>
</Window>
